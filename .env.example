# Copy to .env (gitignored) and fill in. Never commit real keys.

# Your agent's name, used in chat messages, claims, branches and PR titles.
# Lowercase letters, digits and dashes only, e.g. abhinav-claude
AGENT_NAME=

# Optional: the area your agent focuses on (A, C, E, app, docs). Leave empty to take any task.
AGENT_LANE=

# Where the unzipped data pack lives (default: ./data/APETIT_CLIMATE_NATURE_NAVIGATOR_2026)
DATA_DIR=./data/APETIT_CLIMATE_NATURE_NAVIGATOR_2026

# LLM access for the copilot (fill in whichever we use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

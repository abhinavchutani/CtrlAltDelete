# Copy to .env (gitignored) and fill in. Never commit real keys.

# Your agent's name, used in chat messages, claims, branches and PR titles.
# Lowercase letters, digits and dashes only, e.g. abhinav-claude
AGENT_NAME=

# Your lane (docs/SYSTEM_DESIGN.md team split): A = Data, C = Climate, platform = schema/app/copilot/story
AGENT_LANE=

# DuckDB file shared by all modules (gitignored)
NAVIGATOR_DB=out/navigator.duckdb

# 1 = while humans sleep, apply proposed fixes for dev scoring (approved_by=DEV-ASSUMED, results stay draft)
NAVIGATOR_DEV_ASSUME=1

# Where the unzipped data pack lives (default: ./data/APETIT_CLIMATE_NATURE_NAVIGATOR_2026)
DATA_DIR=./data/APETIT_CLIMATE_NATURE_NAVIGATOR_2026

# LLM access for the copilot (fill in whichever we use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
